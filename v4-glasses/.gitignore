catalog/cache/*.pdf
catalog/cache/*.PDF

# Evaluation image sets (your data, not source)
eval/datasets/

# Frozen thresholds are generated by calibration; keep the example only
server/thresholds.json

# Local secrets
.env

# ESP-IDF build output
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
